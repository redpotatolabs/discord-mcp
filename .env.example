# Copy to ~/.config/discord-mcp/env (chmod 600), or set DISCORD_MCP_ENV_FILE.
# Real environment variables override this file.

# Bot token from the Developer Portal (Bot tab). Required, or use DISCORD_TOKEN_FILE.
DISCORD_TOKEN=

# Default guild for tools when guild_id is omitted. Also becomes the allowlist
# unless DISCORD_ALLOWED_GUILD_IDS is set.
DISCORD_GUILD_ID=

# Comma-separated guild IDs the server may touch. "*" = every guild the bot is in.
# DISCORD_ALLOWED_GUILD_IDS=

# Expose only read tools (and GET-only raw requests).
# DISCORD_READ_ONLY=false

# debug | info | warn | error (logs go to stderr)
# LOG_LEVEL=info
